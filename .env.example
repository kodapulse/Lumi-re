# Copie ce fichier en .env pour le développement local (npm run dev).
# Sur GitHub : Settings > Secrets and variables > Actions (voir README).
VITE_BASE44_APP_ID=
# Optionnel (défaut : https://base44.app)
# VITE_BASE44_SERVER_URL=https://base44.app
# Jeton "API Read Access Token" TMDB (visible dans le site compilé, voir README)
VITE_TMDB_API_READ_ACCESS_TOKEN=
